{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXAIS Football AI implementation ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "milestone",
    "priority",
    "status",
    "area",
    "outcome",
    "scope",
    "non_goals",
    "acceptance_checks",
    "dependencies",
    "risks",
    "source_refs",
    "evidence",
    "github_issue",
    "body_path"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EFA-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "enum": [
        "M1",
        "M2",
        "M3",
        "M4"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "in_progress",
        "implemented",
        "blocked",
        "done"
      ]
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "acceptance_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 3
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EFA-[0-9]{3}$"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "github_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "url"
      ],
      "properties": {
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://github\\.com/mfreeze77/exais-football-ai/issues/[1-9][0-9]*$"
        }
      }
    },
    "body_path": {
      "type": "string",
      "pattern": "^docs/tickets/EFA-[0-9]{3}\\.md$"
    }
  }
}
