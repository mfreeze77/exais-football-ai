{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXAIS Football AI ticket catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "repository",
    "updated_at",
    "milestones",
    "sources",
    "tickets"
  ],
  "properties": {
    "$schema": {
      "const": "./catalog.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "repository": {
      "const": "mfreeze77/exais-football-ai"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "exit_criteria"
        ],
        "properties": {
          "id": {
            "enum": [
              "M1",
              "M2",
              "M3",
              "M4"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "in_progress",
              "implemented",
              "blocked",
              "done"
            ]
          },
          "exit_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "kind",
          "revision",
          "reviewed_at",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "kind": {
            "enum": [
              "upstream_code",
              "official_documentation"
            ]
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tickets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./ticket.schema.json"
      }
    }
  }
}
